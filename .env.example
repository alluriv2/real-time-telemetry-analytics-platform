POSTGRES_DB=weather_db
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=raw_weather_events_python_aws
KAFKA_CLIENT_ID=weather-producer-aws
KAFKA_CONSUMER_GROUP=weather-postgres-consumer-aws
CONSUMER_BATCH_SIZE=500
CONSUMER_BATCH_TIMEOUT_SECONDS=1.0
PRODUCER_POLL_SECONDS=120
RECONCILIATION_LOOKBACK_DAYS=2

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000

DASH_HOST=0.0.0.0
DASH_PORT=8050

WAVERLY_STATION=wx_waverly
WAVERLY_STATION_URL=https://tylerconlon.com/wx/logs/wx_waverly/
EAST_STREET_STATION=wx_east_st
EAST_STREET_STATION_URL=https://tylerconlon.com/wx/logs/wx_east_st/

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-another-strong-password
